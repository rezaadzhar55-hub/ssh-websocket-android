<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textColor="#152238"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_subtitle"
            android:textColor="#58677D"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#EAF0F8"
            android:padding="14dp"
            android:text="@string/status_disconnected"
            android:textColor="#152238"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ssh_section"
            android:textColor="#152238"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ssh_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ssh_host_hint"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/ssh_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ssh_port_hint"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/ssh_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ssh_user_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/ssh_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ssh_password_hint"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/websocket_section"
            android:textColor="#152238"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ws_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ws_host_hint"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/ws_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ws_port_hint"
            android:inputType="number"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/ws_tls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/ws_tls" />

        <EditText
            android:id="@+id/ws_payload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/ws_payload_hint"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="7"
            android:maxLines="12"
            android:fontFamily="monospace"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/ws_payload_help"
            android:textColor="#58677D"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/security_section"
            android:textColor="#152238"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/host_fingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fingerprint_hint"
            android:inputType="textVisiblePassword"
            android:singleLine="true"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/observed_fingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#58677D"
            android:textSize="13sp" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/save_profile" />

        <Button
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect" />

        <Button
            android:id="@+id/clear_button"
            style="@android:style/Widget.Material.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear_profile" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/usage_note"
            android:textColor="#58677D"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/log_section"
            android:textColor="#152238"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp"
            android:background="#0E1621"
            android:fillViewport="true">

            <TextView
                android:id="@+id/log_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:textColor="#C9D6E4"
                android:textSize="11sp" />
        </ScrollView>

        <Button
            android:id="@+id/log_clear_button"
            style="@android:style/Widget.Material.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/log_clear" />
    </LinearLayout>
</ScrollView>
